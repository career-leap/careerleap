# =============================================================================
# CareerLeap Docker Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your local development
# This file is used by docker-compose.yml
# =============================================================================

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a secure secret key for production using:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-in-production

# Set to False for production
DEBUG=True

# Allowed hosts (backend container name included for internal communication)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS origins (frontend container name included for internal communication)
CORS_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://frontend:5177

# =============================================================================
# JWT SETTINGS
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False

# =============================================================================
# FRONTEND URL
# =============================================================================
FRONTEND_URL=http://localhost:5177

# =============================================================================
# EMAIL SETTINGS (for development)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@careerleap.com

# =============================================================================
# DATABASE SETTINGS (handled by docker-compose, usually don't need to change)
# =============================================================================
# DB_NAME=careerleap
# DB_USER=careerleap_user
# DB_PASSWORD=careerleap_pass
# DB_HOST=db
# DB_PORT=5432
