# =============================================================================
# CareerLeap Django Backend - Docker Environment
# =============================================================================
# This file is used when running the backend in Docker
# Copy to .env for local container development
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (Docker internal network)
# =============================================================================
DB_NAME=careerleap
DB_USER=careerleap_user
DB_PASSWORD=careerleap_pass
DB_HOST=db
DB_PORT=5432

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5177,http://frontend:5177

# =============================================================================
# JWT SETTINGS
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False

# =============================================================================
# EMAIL SETTINGS — Resend (https://resend.com)
# =============================================================================
# For Docker dev: emails go to console by default
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production Docker: switch to SMTP and set RESEND_API_KEY env var
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=${RESEND_API_KEY}
DEFAULT_FROM_EMAIL=info@career-leap.academy


# =============================================================================
# FRONTEND URL
# =============================================================================
FRONTEND_URL=http://localhost:5177
