# =============================================================================
# CareerLeap Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_NAME=careerleap
DB_USER=careerleap_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# SECURITY SETTINGS - CRITICAL: Change these for production!
# =============================================================================

# Generate a secure secret key using:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-your-secure-secret-key-minimum-50-characters-long

# Set to False for production
DEBUG=False

# Comma-separated list of allowed hosts
# Example: api.careerleap.com,www.careerleap.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins
# Example: https://careerleap.com,https://www.careerleap.com
CORS_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# =============================================================================
# JWT SETTINGS
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False

# =============================================================================
# HTTPS/SSL SETTINGS (Enable for production)
# =============================================================================
# Uncomment and enable these for production with HTTPS
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# EMAIL SETTINGS
# =============================================================================
# For development - emails printed to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production - configure SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@careerleap.com

# =============================================================================
# FRONTEND URL
# =============================================================================
# Used for password reset links and CORS
FRONTEND_URL=http://localhost:5177

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# For development - local memory cache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# For production - Redis recommended
# CACHE_BACKEND=django_redis.cache.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
