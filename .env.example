# =============================================================================
# CareerLeap Frontend Environment Configuration
# =============================================================================
# Copy this file to .env or .env.docker and update with your actual values.
# NEVER commit .env files to version control!
# =============================================================================

# Backend API URL used by the React frontend
# For local development with Vite proxy: /api
# For direct backend access: http://localhost:8000/api
VITE_API_URL=/api

# Optional: Calendly scheduling link shown on the homepage
VITE_CALENDLY_URL=https://calendly.com/your-calendar-link
